{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "viewer.py (NO PLOT)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/viewer.py",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "MUJOCO_GL": "glfw"
      }
    },
    {
      "name": "viewer.py (plot forces)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/viewer.py",
      "args": ["--plot-forces"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "MUJOCO_GL": "glfw"
      }
    }
  ]
}
